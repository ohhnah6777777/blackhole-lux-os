{
  "name": "blackhole-os-desktop",
  "version": "1.0.0",
  "description": "Blackhole OS desktop shell",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package:mac": "electron-packager . \"Blackhole OS\" --platform=darwin --arch=x64 --out=release --overwrite",
    "package:win": "electron-packager . \"Blackhole OS\" --platform=win32 --arch=x64 --out=release --overwrite",
    "package:linux": "electron-packager . \"Blackhole OS\" --platform=linux --arch=x64 --out=release --overwrite"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "@electron/packager": "^18.3.6"
  }
}
